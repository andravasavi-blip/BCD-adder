`timescale 1ns/1ps

module bcd_adder_tb;

reg [3:0] A, B;
reg Cin;
wire [3:0] Sum;
wire Cout;

bcd_adder uut (
    .A(A),
    .B(B),
    .Cin(Cin),
    .Sum(Sum),
    .Cout(Cout)
);

initial begin
    $display("Time\tA\tB\tCin\tSum\tCout");
    $monitor("%0t\t%d\t%d\t%b\t%d\t%b",
             $time, A, B, Cin, Sum, Cout);

    A = 4'd2; B = 4'd3; Cin = 0; #10;   // 2 + 3 = 5
    A = 4'd4; B = 4'd5; Cin = 0; #10;   // 4 + 5 = 9
    A = 4'd5; B = 4'd7; Cin = 0; #10;   // 5 + 7 = 12
    A = 4'd8; B = 4'd9; Cin = 0; #10;   // 8 + 9 = 17
    A = 4'd9; B = 4'd9; Cin = 1; #10;   // 9 + 9 + 1 = 19

    $finish;
end

endmodule